{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2018", "DOM"],
    "types": ["node"],
    "paths": {
      "posipaki": ["./src/index.ts"],
      "posipaki/remote": ["./src/remote/index.ts"],
      "posipaki/remote/node": ["./src/remote/node.ts"],
      "posipaki/testing": ["./src/testing/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": []
}
