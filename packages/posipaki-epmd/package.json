{
  "name": "posipaki-epmd",
  "version": "0.0.1",
  "description": "Talk to an Erlang node over its own distribution protocol",
  "homepage": "https://posipaki-docs.muromec.nl/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muromec/posipaki.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "bin": { "posipaki-epmd-mapper": "./dist/mapper-cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bash ../../scripts/package-build.sh",
    "prepack": "bash ../../scripts/package-build.sh",
    "client": "bun demo/client.ts",
    "node": "bun demo/node.ts",
    "mapper": "bun src/mapper-cli.ts"
  },
  "dependencies": {
    "posipaki": "^0.51.0"
  }
}
